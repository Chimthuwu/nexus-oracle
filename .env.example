# ── Nexus environment template ─────────────────────────────────────────────
# Copy to `.env` and fill in real values. NEVER commit real keys. The real
# `.env` lives at the repo root and is gitignored.

# ── Bucket A — OpenRouter (independent account bucket) ────────────────────
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
# Primary model. Free-tier quality varies wildly per model, so set a model you
# verified live (tool call + a real answer) with `npm run sanity -w apps/server`.
# Defaults to openrouter/free (the self-updating auto-router) if unset.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Comma-separated rotation tried after the primary, still inside Bucket A:
# verified :free models first, then openrouter/free as the self-updating backstop.
# Never add a model you have not verified with a live tool-call probe.
OPENROUTER_EXTRA_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,openrouter/free

# ── Bucket B — NVIDIA NIM (independent free bucket; 5 keys rotate) ─────────
# Keys 1–5. Bucket B activates only when NVIDIA_MODEL is set AND at least one
# key is present. Verify tool-calling support per model before setting NVIDIA_MODEL.
NVIDIA_API_KEY=nvapi-your-nvidia-key-1
NVIDIA_API_KEY2=nvapi-your-nvidia-key-2
NVIDIA_API_KEY3=nvapi-your-nvidia-key-3
NVIDIA_API_KEY4=nvapi-your-nvidia-key-4
NVIDIA_API_KEY5=nvapi-your-nvidia-key-5
# NVIDIA_MODEL=nvidia/example-instruct-model-verified-for-tools

# ── Text-to-speech (freetts.org) ─────────────────────────────────────────
# The Oracle speaks its replies aloud. Server proxies freetts.org's v1 API
# (browser can't call it — CORS + key). Set this locally AND on Render.
# Without it the /api/oracle/tts route returns 503 and the app just stays silent.
FREETTS_API_KEY=your-freetts-v1-api-key
# Optional voice id (default: en-US-JennyNeural)
# FREETTS_VOICE=en-US-JennyNeural

# ── Server ─────────────────────────────────────────────────────────────────
PORT=8787
HOST=0.0.0.0
